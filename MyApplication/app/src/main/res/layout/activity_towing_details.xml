<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Towing Company Profile Photo -->
        <ImageView
            android:id="@+id/ivTowingPhoto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera" />

        <!-- Towing Company Name -->
        <TextView
            android:id="@+id/tvTowingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Towing Company Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal" />

        <!-- Towing Services -->
        <TextView
            android:id="@+id/tvTowingServices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Services: "
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_gravity="center_horizontal" />

        <!-- Experience -->
        <TextView
            android:id="@+id/tvExperience"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Experience: "
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_gravity="center_horizontal" />

        <!-- Distance -->
        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distance: "
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_gravity="center_horizontal" />

        <!-- Towing Phone (Initially hidden) -->
        <TextView
            android:id="@+id/tvTowingPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Towing Phone: "
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <!-- Message Input -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your message"
            android:layout_marginTop="10dp" />

        <!-- Request Button -->
        <Button
            android:id="@+id/btnRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request"
            android:layout_marginTop="10dp" />

        <!-- Locate Button -->
        <Button
            android:id="@+id/btnLocate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Locate"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>
