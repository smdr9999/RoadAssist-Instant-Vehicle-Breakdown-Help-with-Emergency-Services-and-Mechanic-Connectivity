<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Profile"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="20dp"/>

        <!-- Profile Picture -->
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerCrop"
            android:layout_marginBottom="15dp"/>

        <!-- Driver Name -->
        <TextView
            android:id="@+id/tvDriverName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: "
            android:textSize="18sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvVehicleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle: "
            android:textSize="18sp"
            android:layout_marginBottom="10dp"/>


        <!-- Phone Number -->
        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone: "
            android:textSize="18sp"
            android:layout_marginBottom="20dp"/>

        <!-- License Image -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="License:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <ImageView
            android:id="@+id/imgLicense"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerCrop"
            android:layout_marginBottom="15dp"/>

        <!-- Insurance Certificate Image -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Insurance Certificate:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <ImageView
            android:id="@+id/imgInsurance"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerCrop"
            android:layout_marginBottom="15dp"/>

        <!-- Find Mechanics Button -->
        <Button
            android:id="@+id/btnFindMechanics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find Nearby Mechanics"
            android:padding="12dp"
            android:textSize="16sp"
            android:backgroundTint="@color/teal_700"
            android:textColor="@color/white"/>

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:padding="12dp"
            android:textSize="16sp"
            android:backgroundTint="@color/red"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"/>
    </LinearLayout>
</ScrollView>
