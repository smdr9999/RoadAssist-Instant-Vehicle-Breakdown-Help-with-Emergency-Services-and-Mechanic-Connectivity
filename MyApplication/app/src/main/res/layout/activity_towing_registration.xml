<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Towing Service Registration"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etExperience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Years of Experience"
            android:inputType="number"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etPermanentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Permanent Address"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnSelectLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Permanent Location"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Location: Fetching..."
            android:textSize="14sp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnUploadPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Photo"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnUploadLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload License"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnUploadPoliceVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Police Verification"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnSelectTowingServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Towing Services"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvSelectedTowingServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Towing Services: Not Selected"
            android:textSize="16sp"
            android:layout_marginTop="5dp" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
